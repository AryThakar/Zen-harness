# LF everywhere, including Windows checkouts (every text file is stored that way already).
* text=auto eol=lf

# Pictures, video, fonts, sounds, the icon and the window's DLLs are binary.
*.png   binary
*.gif   binary
*.jpg   binary
*.ico   binary
*.mp4   binary
*.ogg   binary
*.woff2 binary
*.xlsx  binary
*.dll   binary

# Measurement results are reviewed as reports (their .md), not line by line.
bench/**/*.json -diff linguist-generated
