# Copy to .env (git-ignored) and fill in. The app reads .env when it starts; a variable already
# set in the environment wins.

# Image generation (generate_image): a secret key (sk_...) from https://enter.pollinations.ai/keys
POLLINATIONS_KEY=
# Optional: another Pollinations image model (default zimage; e.g. flux is cheaper, slower)
# POLLINATIONS_MODEL=zimage

# The assistant's name and yours (its persona); without a name it says "the user".
# ASSISTANT_NAME=Zen
# ASSISTANT_USER_NAME=
